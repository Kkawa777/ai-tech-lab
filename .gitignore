# OS
.DS_Store
Thumbs.db

# Jekyll build output (never commit the built site)
_site/
.jekyll-cache/

# Editor
.vscode/
.idea/
*.swp

# Arduino / PlatformIO
.pio/
.pioenvs/
.piolibdeps/
build/
*.hex
*.elf

# Node (tooling, if used)
node_modules/

# Python (scripts/)
__pycache__/
*.pyc

# Dev Log automation: operational run logs (JSONL), not site content or
# reviewed documentation (scripts/devlogkit/observability.py)
devlog-logs/

# Environment / secrets
.env
.env.local

# Logs
*.log

# cc-company (internal task/notes, not for public repo)
.company/

# Agent Skills (generated; restore via `npx skills experimental_install`)
# Only the package-managed skills are ignored by name (not `.claude/skills/` as a
# whole) so project-authored skills such as quality-development stay in Git.
# Git cannot re-include a file once a parent directory is excluded, so a blanket
# `.claude/skills/` ignore + negation does not work here.
.agents/
.claude/skills/frontend-design/
.claude/skills/seo/
.claude/skills/skill-development/

# Claude Code local runtime state (session-specific, not project source)
.claude/scheduled_tasks.lock

# Scratch / working files
scratchpad/

# Separate practice repo (has its own .git/), not part of this project
claude-code-practice/

# Sibling projects (each has its own .git/, unrelated to AI-Tech-Lab; may contain .env secrets)
ai-content-engine/
global-trend-discovery/
line-stock-news-bot/
